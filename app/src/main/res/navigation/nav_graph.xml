<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.personal.vbr.ui.screens.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_editor"
            app:destination="@id/editorFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>

    <fragment
        android:id="@+id/editorFragment"
        android:name="com.personal.vbr.ui.screens.EditorFragment"
        android:label="Editor"
        tools:layout="@layout/fragment_editor">
        <argument
            android:name="video_uri"
            app:argType="android.net.Uri"
            app:nullable="true"/>
        <action
            android:id="@+id/action_editor_to_export"
            app:destination="@id/exportFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right"/>
        <action
            android:id="@+id/action_editor_to_trim"
            app:destination="@id/trimFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/exportFragment"
        android:name="com.personal.vbr.ui.screens.ExportFragment"
        android:label="Export"
        tools:layout="@layout/fragment_export"/>

    <fragment
        android:id="@+id/trimFragment"
        android:name="com.personal.vbr.ui.screens.TrimFragment"
        android:label="Trim"
        tools:layout="@layout/fragment_trim"/>

</navigation>
