<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export"
            android:textSize="28sp"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Resolution picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resolution"
            android:textColor="@color/on_surface"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton android:id="@+id/radio480p"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="480p  (~11 MB/min)"
                android:textColor="@color/on_surface"
                android:paddingStart="16dp"/>

            <RadioButton android:id="@+id/radio720p"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="720p  (~22 MB/min)"
                android:textColor="@color/on_surface"
                android:paddingStart="16dp"
                android:checked="true"/>

            <RadioButton android:id="@+id/radio1080p"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="1080p (~37 MB/min)"
                android:textColor="@color/on_surface"
                android:paddingStart="16dp"/>

        </RadioGroup>

        <!-- Estimated file size -->
        <TextView
            android:id="@+id/tvSizeEstimate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estimated size: —"
            android:textColor="@color/on_surface_dim"
            android:layout_marginBottom="32dp"/>

        <!-- Export button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartExport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Export Video"
            android:textSize="16sp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/black"
            app:cornerRadius="12dp"/>

        <!-- Export progress group (hidden until export starts) -->
        <LinearLayout
            android:id="@+id/exportProgressGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="24dp">

            <ProgressBar
                android:id="@+id/exportProgressBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"/>

            <TextView
                android:id="@+id/tvExportProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/on_surface_dim"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelExport"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Cancel"
                android:backgroundTint="@color/danger"
                android:textColor="@color/white"
                android:layout_marginTop="12dp"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
